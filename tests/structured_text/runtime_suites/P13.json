          },
          "cycles": 1,
          "expect": {
            "TEMP_SETPOINT_ADJUST": 3
          }
        },
        {
          "set": {
            "ENERGY_SAVING_MODE": false
          },
          "cycles": 1,
          "expect": {
            "TEMP_SETPOINT_ADJUST": 2
          }
        }
      ],
      "scenario": "Unoccupied Auto, energy-save: +3 C; standard: +2 C."
    },
    {
      "id": "P13-T3",
      "steps": [
        {
          "set": {
            "HVAC_MODE_SELECTOR": 3
          },
          "cycles": 1,
          "expect": {
            "TEMP_SETPOINT_ADJUST": 4,
            "SUPPLY_FAN_RUN": false
          }
        }
      ],
      "scenario": "Night mode: +4 C and fan off regardless of occupancy."
    }
  ]
