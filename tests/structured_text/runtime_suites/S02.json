{
  "task_id": "S02",
  "cases": [
    {
      "id": "S02-T1",
      "steps": [
        {
          "set": {
            "EStopOK": true,
            "Start": true,
            "PartAtEntry": true,
            "PartAtExit": false,
            "Stop": false,
            "CycleTime": "T#50ms"
          },
          "cycles": 1,
          "expect": {
            "ConveyorForward": true,
            "ConveyorReverse": false
          }
        }
      ],
      "scenario": "PartAtEntry with Start: forward begins; no reverse output."
    },
    {
      "id": "S02-T2",
      "steps": [
        {
          "set": {
            "Jam": true
          },
          "cycles": 1,
          "expect": {
            "ConveyorForward": false,
            "ConveyorReverse": true,
            "RetryCount": 1
          }
        },
        {
          "set": {
            "Jam": false
          },
          "cycles": 18,
          "expect": {
            "ConveyorReverse": true
          }
        },
        {
          "set": {},
          "cycles": 3,
          "expect": {
            "ConveyorForward": true,
            "ConveyorReverse": false
          }
        }
      ],
      "scenario": "Jam during forward: forward drops in the same scan, reverse starts, then a cleared jam retries forward after 1 s."
    },
    {
      "id": "S02-T3",
      "steps": [
        {
          "set": {
            "Jam": true
          },
          "cycles": 1,
          "expect": {
            "ConveyorReverse": true,
            "RetryCount": 2
          }
        },
        {
          "set": {
            "Jam": false
          },
          "cycles": 21,
          "expect": {
            "ConveyorForward": true
          }
        },
        {
          "set": {
            "Jam": true
          },
          "cycles": 1,
          "expect": {
            "FaultLatched": true,
            "RetryCount": 2,
            "ConveyorForward": false,
            "ConveyorReverse": false
          }
        }
      ],
      "scenario": "Two jam events cause two reverse attempts; a third event latches fault, leaves count at 2, and stops both directions."
    },
    {
      "id": "S02-T4",
      "steps": [
        {
          "set": {
            "PartAtExit": true,
            "PartAtEntry": false,
            "Jam": false,
            "Start": false
          },
          "cycles": 1
        },
        {
          "set": {
            "PartAtExit": false,
            "Start": true,
            "PartAtEntry": true
          },
          "cycles": 1,
          "expect": {
            "ConveyorForward": true
          }
        },
        {
          "set": {
            "Jam": true
          },
          "cycles": 1,
          "expect": {
            "ConveyorReverse": true
          }
        },
        {
          "set": {
            "EStopOK": false
          },
          "cycles": 1,
          "expect": {
            "ConveyorForward": false,
            "ConveyorReverse": false,
            "FaultLatched": true
          }
        }
      ],
      "scenario": "E-stop while reversing: both directions stop immediately and fault latches."
    },
    {
      "id": "S02-T5",
      "steps": [
        {
          "set": {
            "EStopOK": true,
            "PartAtExit": true,
            "Jam": false,
            "Start": false
          },
          "cycles": 1,
          "expect": {
            "RetryCount": 0
          }
        },
        {
          "set": {
            "PartAtExit": false,
            "Start": true
          },
          "cycles": 1,
          "expect": {
            "FaultLatched": false
          }
        }
      ],
      "scenario": "PartAtExit resets RetryCount; safe Start rising edge clears a fault."
    }
  ]
}
